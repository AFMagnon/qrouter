# Copy to `.env` and fill in. Never commit `.env`.

# IBM Quantum
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_CHANNEL=ibm_quantum

# Amazon Braket (standard AWS variables)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_BRAKET_S3_BUCKET=
AWS_BRAKET_S3_PREFIX=qrouter

# OQTOPUS Cloud
OQTOPUS_API_TOKEN=
OQTOPUS_API_URL=

# Logging
QROUTER_LOG_LEVEL=INFO
QROUTER_LOG_JSON=0
